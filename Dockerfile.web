# syntax=docker/dockerfile:1
# Build context: root repo.

FROM node:22-alpine AS build
# packageManager di package.json mengunci pnpm; pnpm terbaru menolak lockfile yang baru dipublish (minimumReleaseAge).
RUN corepack enable
WORKDIR /app
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
# Store pnpm di-cache antar build: install ulang hanya mengambil paket yang berubah.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY apps/web/ ./
# Aplikasi disajikan di /app/, jadi aset dibangun dengan base /app/.
RUN pnpm exec tsc -b && pnpm exec vite build --base=/app/

FROM nginx:1.27-alpine AS runtime
# API_UPSTREAM = alamat internal service API, mis. "simas-api:8080"
ENV API_UPSTREAM=api:8080
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY landing/index.html /usr/share/nginx/html/index.html
COPY --from=build /app/dist /usr/share/nginx/html/app
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
